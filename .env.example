# Public URL used by local/server-side configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Auth endpoint for the active environment. This URL is not a secret, but
# it must point to the correct Neon branch (development/preview/production).
NEON_AUTH_BASE_URL=

# Server-only secret used to sign the Neon Auth session cache cookie.
# Generate at least 32 random characters. Never expose through NEXT_PUBLIC_*.
NEON_AUTH_COOKIE_SECRET=

# Database and Google Calendar variables are added by their respective backlog
# items. Never commit real secret values to this file.
